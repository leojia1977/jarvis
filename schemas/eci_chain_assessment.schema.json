{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secupilot.local/schemas/eci_chain_assessment.schema.json",
  "title": "SecuPilot ECI Chain Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "case_id",
    "stage_label",
    "stage_number",
    "stage_status",
    "confidence",
    "evidence_refs",
    "evidence_gaps",
    "prompt_injection_handling",
    "human_review_required",
    "automatic_containment_allowed"
  ],
  "properties": {
    "schema_version": { "const": "eci_vfe.v0.2" },
    "assessment_id": { "type": "string", "pattern": "^eci-assessment-" },
    "case_id": { "type": "string" },
    "stage_label": { "$ref": "#/$defs/authority_string" },
    "stage_number": { "$ref": "#/$defs/authority_number" },
    "stage_status": {
      "allOf": [
        { "$ref": "#/$defs/authority_string" },
        {
          "properties": {
            "value": {
              "enum": [
                "LOW_STAGE_MONITOR",
                "INITIAL_ACCESS_SUSPECTED",
                "LATERAL_MOVEMENT_SUSPECTED",
                "IMMEDIATE_HUMAN_CONFIRMATION_REQUIRED",
                "HIGH_STAGE_SUSPECTED_SHORT_OBSERVATION",
                "INSUFFICIENT_EVIDENCE_WITH_PRIORITY_GAPS"
              ]
            }
          }
        }
      ]
    },
    "confidence": { "$ref": "#/$defs/authority_number" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "evidence_gaps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence_gap" }
    },
    "prompt_injection_handling": { "$ref": "#/$defs/prompt_injection_handling" },
    "human_review_required": { "const": true },
    "automatic_containment_allowed": { "const": false }
  },
  "$defs": {
    "authority_string": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "confidence", "evidence_refs", "is_authoritative"],
      "properties": {
        "value": { "type": "string" },
        "source": { "$ref": "#/$defs/authority_source" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "is_authoritative": { "type": "boolean" },
        "signoff_ref": { "type": "string" }
      },
      "allOf": [{ "$ref": "#/$defs/llm_never_authoritative_by_default" }]
    },
    "authority_number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "confidence", "evidence_refs", "is_authoritative"],
      "properties": {
        "value": { "type": "number" },
        "source": { "$ref": "#/$defs/authority_source" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "is_authoritative": { "type": "boolean" },
        "signoff_ref": { "type": "string" }
      },
      "allOf": [{ "$ref": "#/$defs/llm_never_authoritative_by_default" }]
    },
    "authority_source": {
      "enum": ["RULE_ENGINE", "LLM_INFERENCE", "ASSET_REGISTRY", "HUMAN_REVIEW", "FIXTURE"]
    },
    "llm_never_authoritative_by_default": {
      "if": {
        "properties": { "source": { "const": "LLM_INFERENCE" } },
        "required": ["source"]
      },
      "then": {
        "properties": { "is_authoritative": { "const": false } }
      }
    },
    "evidence_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap",
        "why_it_matters",
        "recommended_query_type",
        "allowed_scope",
        "urgency",
        "window_closes_in",
        "deadline_basis",
        "fallback_if_missed"
      ],
      "properties": {
        "gap": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "recommended_query_type": { "type": "string" },
        "allowed_scope": { "const": "metadata_only" },
        "urgency": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "window_closes_in": { "type": "string" },
        "deadline_basis": {
          "enum": [
            "endpoint log rotation",
            "SIEM ingestion delay",
            "short-lived process evidence",
            "volatile memory evidence",
            "network flow retention",
            "cloud audit delay",
            "human business context needed"
          ]
        },
        "fallback_if_missed": { "type": "string" }
      }
    },
    "prompt_injection_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_injection_detected",
        "raw_injection_retained",
        "sanitized_summary",
        "forbidden_output_present",
        "guard_status"
      ],
      "properties": {
        "input_injection_detected": { "type": "boolean" },
        "injection_source_field": { "type": "string" },
        "raw_injection_retained": { "const": false },
        "sanitized_summary": { "type": "string" },
        "forbidden_output_present": { "const": false },
        "guard_status": { "enum": ["PASS", "PASS_WITH_SANITIZATION"] }
      }
    }
  }
}
