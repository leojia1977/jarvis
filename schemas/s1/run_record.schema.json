{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secupilot.local/schemas/s1/run_record.schema.json",
  "title": "SecuPilot S1 Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "artifact_dir",
    "case_count",
    "data_boundary",
    "environment_boundary",
    "go_record_ref",
    "governance_refs",
    "input_kind",
    "input_load_error",
    "input_ref",
    "operator",
    "operator_account",
    "provider",
    "qwen_used",
    "source_ids",
    "start_time_utc",
    "end_time_utc",
    "workdir"
  ],
  "properties": {
    "schema_version": {
      "const": "secupilot.s1.run_record.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_dir": {
      "type": "string",
      "minLength": 1
    },
    "case_count": {
      "type": "integer",
      "minimum": 0
    },
    "data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_input_scope",
        "customer_visible_output",
        "data_mode",
        "production_connectors_enabled",
        "production_writeback",
        "raw_payload_retention",
        "secret_token_auth_header_retention",
        "writeback_enabled"
      ],
      "properties": {
        "allowed_input_scope": {
          "type": "string",
          "minLength": 1
        },
        "customer_visible_output": {
          "type": "boolean"
        },
        "data_mode": {
          "type": "string",
          "minLength": 1
        },
        "production_connectors_enabled": {
          "type": "boolean"
        },
        "production_writeback": {
          "type": "boolean"
        },
        "raw_payload_retention": {
          "type": "boolean"
        },
        "secret_token_auth_header_retention": {
          "type": "boolean"
        },
        "writeback_enabled": {
          "type": "boolean"
        }
      }
    },
    "environment_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_boundary_proof_ref",
        "environment_id",
        "isolation_proof_ref",
        "no_writeback_proof_ref"
      ],
      "properties": {
        "access_boundary_proof_ref": {
          "type": "string",
          "minLength": 1
        },
        "environment_id": {
          "type": "string",
          "minLength": 1
        },
        "isolation_proof_ref": {
          "type": "string",
          "minLength": 1
        },
        "no_writeback_proof_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "go_record_ref": {
      "type": "string",
      "minLength": 1
    },
    "governance_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_policy_ref",
        "reviewer_register_ref",
        "stop_clean_delete_ref"
      ],
      "properties": {
        "retention_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_register_ref": {
          "type": "string",
          "minLength": 1
        },
        "stop_clean_delete_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_kind": {
      "type": "string",
      "minLength": 1
    },
    "input_load_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_ref": {
      "type": "string",
      "minLength": 1
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "operator_account": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "fixture",
        "external-output"
      ]
    },
    "qwen_used": {
      "type": "boolean"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "start_time_utc": {
      "type": "string",
      "minLength": 1
    },
    "end_time_utc": {
      "type": "string",
      "minLength": 1
    },
    "workdir": {
      "type": "string",
      "minLength": 1
    }
  }
}
